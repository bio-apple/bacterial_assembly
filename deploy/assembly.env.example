# Copy to /etc/bacterial-assembly/assembly.env and chmod 600.
# Do not commit real secrets. Generate secret with: openssl rand -hex 32

# Repository checkout on this host
ASSEMBLY_REPO=/opt/bacterial-assembly

# Absolute data root (required for Docker bind mounts; do not use a relative path)
ASSEMBLY_DATA_ROOT=/srv/bacterial-assembly/data
ASSEMBLY_USERS_FILE=/etc/bacterial-assembly/users.json
ASSEMBLY_SQLITE_PATH=/srv/bacterial-assembly/data/database/jobs.sqlite3

ASSEMBLY_WEB_SECRET=
# true behind HTTPS reverse proxy; false if the browser uses http://127.0.0.1:8000
ASSEMBLY_SESSION_COOKIE_SECURE=true

# Orchestration (keep existing names)
TASK_BACKEND=postgres_rq
TOOL_RUNTIME=docker
DATABASE_URL=postgresql://assembly:CHANGE_ME@127.0.0.1:5432/assembly
REDIS_URL=redis://127.0.0.1:6379/0

# Optional: Docker Engine URL (default: unix:///var/run/docker.sock)
# DOCKER_HOST=unix:///var/run/docker.sock

# Python environments (used by systemd unit PATH / docs)
ASSEMBLY_VENV=/opt/bacterial-assembly/.venv
ASSEMBLY_MAMBA_ENV=/opt/bacterial-assembly/.mamba/envs/validate
