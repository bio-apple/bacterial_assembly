# Copy to .env and replace with: openssl rand -hex 32
ASSEMBLY_WEB_SECRET=
# true behind HTTPS reverse proxy; false if the browser uses http://127.0.0.1:8000
ASSEMBLY_SESSION_COOKIE_SECURE=true
APP_UID=1000
APP_GID=1000
# Formal path runs bio tools in sidecar containers (ADR 0010). Use local only for transition/mock.
TOOL_RUNTIME=docker
# Host docker group GID so the worker can use /var/run/docker.sock
DOCKER_GID=0
# PostgreSQL / Redis (ADR 0015)
POSTGRES_USER=assembly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assembly
# Inside Compose use service hostnames; from the host use localhost:5433 / :6380
DATABASE_URL=postgresql://assembly:change-me@postgres:5432/assembly
REDIS_URL=redis://redis:6379/0
TASK_BACKEND=postgres_rq
ASSEMBLY_SQLITE_PATH=/data/database/jobs.sqlite3
